<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hymnapp.dbautosync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/macbookpro/.openclaw/workspace/hymn-app/ops/deploy/nightly-db-sync.mjs</string>
    <string>--max-wait-min</string>
    <string>120</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>19</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/hymn_dbsync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hymn_dbsync.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/macbookpro/.openclaw/workspace/hymn-app</string>
</dict>
</plist>
