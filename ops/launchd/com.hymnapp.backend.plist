<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hymnapp.backend</string>

    <!-- Absolute paths: launchd has no shell, so `node` alone wouldn't resolve. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend/server.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend</string>

    <!-- CRITICAL: launchd's default PATH is /usr/bin:/bin:/usr/sbin:/sbin, which does
         NOT include /opt/homebrew/bin. The backend shells out to `yt-dlp` (which also
         needs python3), so without this the server would start happily but every single
         song resolve would fail with "command not found" — i.e. the app connects but
         no audio ever plays. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- JWT_SECRET (MEMBERSHIP-PLAN §5.1) is REQUIRED — server.js refuses to
             boot without it (backend/lib/authSecret.js). DO NOT put the real
             value here — this file is committed to git. Set it only in the
             INSTALLED copy at ~/Library/LaunchAgents/com.hymnapp.backend.plist,
             which lives outside the repo. Generate with:
               node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
        -->
        <key>JWT_SECRET</key>
        <string>REPLACE-WITH-YOUR-OWN-SECRET-DO-NOT-COMMIT-A-REAL-VALUE</string>

        <!-- Twilio Verify (ERIC-TODO-PHONE-AUTH.md §A2). Same rule as
             JWT_SECRET: real values go ONLY in the installed copy at
             ~/Library/LaunchAgents/com.hymnapp.backend.plist, never here.
             otpAuth.js returns 503 "not_configured" until all three are set,
             so it's safe to have some but not all of them present. -->
        <key>TWILIO_ACCOUNT_SID</key>
        <string>REPLACE-WITH-YOUR-OWN-TWILIO-ACCOUNT-SID</string>
        <key>TWILIO_AUTH_TOKEN</key>
        <string>REPLACE-WITH-YOUR-OWN-TWILIO-AUTH-TOKEN</string>
        <key>TWILIO_VERIFY_SERVICE_SID</key>
        <string>REPLACE-WITH-YOUR-OWN-TWILIO-VERIFY-SERVICE-SID</string>
    </dict>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically if it ever exits/crashes. This is what makes it
         "come back on its own" without anyone touching it. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Don't hammer restarts if it's crash-looping. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/hymn_backend.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hymn_backend.log</string>
</dict>
</plist>
