<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hymnapp.fetchlyrics</string>

    <!-- 歌詞入庫夜晚隊列(LYRICS-PIPELINE-PLAN)。2026-07-24 STAGE 2 起:每晚一次過
         行兩層 —— CC 字幕層(平,處理新收錄嘅歌)先,跟住 OCR 層(主力,
         落片+抽frame+Vision OCR+需要時 whisper 後備,一首幾分鐘)。
         CC 揾唔到嘅歌(source='cc:miss')先會入 OCR 隊,唔會夜夜重 CC。
         2026-07-24 Eric 拍板加速:每晚最少 20 首 → CC 25 + OCR 20。
         ⚠️ CC budget 一定要 ≥ OCR budget:cc:miss 存貨係 OCR 嘅糧,CC 實測
         命中率 ~0%,即係每晚 OCR 食幾多就要 CC 產幾多,細過佢 OCR 會斷糧。
         20 首 OCR 預計 40-90 分鐘,05:00 開波遠早過 09:00 窗口尾,夠鬆。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend/scripts/fetchLyrics.js</string>
        <string>--cc-budget</string>
        <string>25</string>
        <string>--ocr-budget</string>
        <string>20</string>
        <string>--delay</string>
        <string>4000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend</string>

    <!-- ⚠️ 一定要 set PATH:launchd 預設冇 /opt/homebrew/bin,fetchLyrics 行 yt-dlp/
         ffmpeg/whisper-cli 呢啲 homebrew 裝嘅工具。唔 set 嘅話每首都
         command-not-found、成個 job 靜靜哋收 0 首(growlibrary 踩過)。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 2026-07-25 由 04:20 改做 05:00(Fable 5 監督 session 診斷咗琴晚
         2026-07-25 04:20 個 run 0 首落地嘅 root cause 之後拍板)——
         checkDeadLinks 04:00 開波,150 首 x 3 秒一首,實測成個 run 要
         ~20-25 分鐘(遠超落 04:00+8min 個估算),佢揸住 hymnDb.js 個
         DB 寫入鎖直到 saveDb() 嗰刻(即成個 run 尾)先放。04:20 開波
         啱啱好撞正佢揸緊鎖嗰段中間,fetchLyrics 嘅 writeLyricsRow 會
         attempt 攞鎖,就算 acquireDbLock 而家已經修好唔會再錯誤咁搶走
         生勾勾嘅鎖(見 hymnDb.js 嘅 pid-alive 檢查),都只會乖乖等到
         checkDeadLinks 放先攞到,即係 CC 層前面幾首基本上係喺度空等。
         05:00 開波,checkDeadLinks 04:00-04:25 一定完咗、鎖一早放咗,
         唔使等。20 首 OCR 預計 40-90 分鐘,05:00 到 09:00 窗口尾仲有
         成 4 個鐘,夠鬆有突。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>5</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/hymn_fetchlyrics.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hymn_fetchlyrics.log</string>
</dict>
</plist>
