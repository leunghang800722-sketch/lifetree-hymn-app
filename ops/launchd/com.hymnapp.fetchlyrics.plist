<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hymnapp.fetchlyrics</string>

    <!-- 歌詞入庫夜晚隊列(LYRICS-PIPELINE-PLAN)。2026-07-24 STAGE 2 起:每晚一次過
         行兩層 —— CC 字幕層(平,處理新收錄嘅歌)先,跟住 OCR 層(主力,
         落片+抽frame+Vision OCR+需要時 whisper 後備,一首幾分鐘)。
         CC 揾唔到嘅歌(source='cc:miss')先會入 OCR 隊,唔會夜夜重 CC。
         2026-07-24 Eric 拍板加速:每晚最少 20 首 → CC 25 + OCR 20。
         ⚠️ CC budget 一定要 ≥ OCR budget:cc:miss 存貨係 OCR 嘅糧,CC 實測
         命中率 ~0%,即係每晚 OCR 食幾多就要 CC 產幾多,細過佢 OCR 會斷糧。
         20 首 OCR 預計 40-90 分鐘,04:20 開波遠早過 09:00 窗口尾,夠鬆。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend/scripts/fetchLyrics.js</string>
        <string>--cc-budget</string>
        <string>25</string>
        <string>--ocr-budget</string>
        <string>20</string>
        <string>--delay</string>
        <string>4000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend</string>

    <!-- ⚠️ 一定要 set PATH:launchd 預設冇 /opt/homebrew/bin,fetchLyrics 行 yt-dlp/
         ffmpeg/whisper-cli 呢啲 homebrew 裝嘅工具。唔 set 嘅話每首都
         command-not-found、成個 job 靜靜哋收 0 首(growlibrary 踩過)。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 04:20 —— 沿用 STAGE 1 揀嘅時間(growlibrary/deadlinkcheck 嗰陣呢個位冇人爭)。
         2026-07-24 加咗 OCR 之後單次 run 會長好多(OCR 一首幾分鐘,6 首 budget
         可以行成 15-30 分鐘),唔再假設「同 growlibrary 一定冇撞期」—— 依家
         真正嘅互斥係 hymnDb.js 嘅 acquireDbLock(見 fetchLyrics.js 檔頭嘅 P0
         修註解):撞正 growLibrary(而家 24 小時每 15 分鐘一次)嗰陣邊個攞唔到
         鎖就 skip 嗰一步,唔會再靠「揀啱時間唔撞」嚟保證安全。04:20 淨係
         「盡量避開,減少空等鎖嘅次數」,唔係安全嘅唯一保證。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>20</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/hymn_fetchlyrics.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hymn_fetchlyrics.log</string>
</dict>
</plist>
