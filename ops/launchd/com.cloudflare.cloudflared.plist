<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.cloudflare.cloudflared</string>

		<!-- NOTE: `cloudflared service install` generates this plist with NO arguments
		     (just the bare binary). That does NOT work for a named tunnel — bare
		     cloudflared only prints "use `cloudflared tunnel run` to start tunnel
		     hymn-api" and exits 1, so launchd crash-loops it and the tunnel stays
		     down (api.god-music.com returns 530). The `tunnel run hymn-api` args
		     below are the fix. If this file is ever regenerated by re-running
		     `cloudflared service install`, these args MUST be re-added. -->
		<key>ProgramArguments</key>
		<array>
			<string>/opt/homebrew/bin/cloudflared</string>
			<string>--config</string>
			<string>/Users/macbookpro/.cloudflared/config.yml</string>
			<string>tunnel</string>
			<string>run</string>
			<string>hymn-api</string>
		</array>

		<key>RunAtLoad</key>
		<true/>

		<!-- Always bring it back, however it exited. -->
		<key>KeepAlive</key>
		<true/>

		<key>ThrottleInterval</key>
		<integer>10</integer>

		<key>StandardOutPath</key>
		<string>/Users/macbookpro/Library/Logs/com.cloudflare.cloudflared.out.log</string>
		<key>StandardErrorPath</key>
		<string>/Users/macbookpro/Library/Logs/com.cloudflare.cloudflared.err.log</string>
	</dict>
</plist>
