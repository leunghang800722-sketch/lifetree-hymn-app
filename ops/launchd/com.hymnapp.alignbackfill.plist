<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hymnapp.alignbackfill</string>

    <!-- 歌詞 STAGE 3「音訊次序驗證層」backfill(scripts/alignBackfill.js)。補返
         2026-07-24~27(STAGE 3 上線之前)已經跑出嚟嘅 draft/verified 舊歌冇
         whisper timeline 呢個缺口(而家約 59 首)——淨係落 bestaudio(唔使成條
         片,輕好多)→ whisper 轉錄(帶 timestamp)→ 存 lyrics_timeline.whisper →
         即刪 audio。純寫 timeline 元資料,唔郁 `lyrics`/`lyrics_status`,已出街
         verified 歌詞內容完全唔受影響。budget 預設 60,59 首存貨一晚做晒有突;
         做完之後(候選清空)呢個 job 之後每晚都係幾秒鐘 no-op,唔使停用佢。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend/scripts/alignBackfill.js</string>
        <string>--budget</string>
        <string>60</string>
        <string>--delay</string>
        <string>5000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macbookpro/.openclaw/workspace/hymn-app/backend</string>

    <!-- ⚠️ 一定要 set PATH:launchd 預設冇 /opt/homebrew/bin,呢個 script 行
         yt-dlp/ffmpeg/whisper-cli 呢啲 homebrew 裝嘅工具(見 ops/launchd/README.md
         嘅「一定要知嘅坑」第1條 —— growlibrary 漏咗呢段連續9次 0 收錄嘅教訓)。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 時序理由(2026-07-27 STAGE 3 上線時排定):
         · checkDeadLinks 04:00-04:25 一早做完,鎖一早放咗。
         · fetchLyrics 05:00 slot(CC50+OCR40,而家每首 OCR 順手加咗 whisper)
           實測預計比舊版(冇 whisper)耗多每首 ~15-30 秒 CPU,40 首 OCR 大概
           加多 10-20 分鐘,原本 05:00 slot 預計 ~55-70 分鐘(~06:10 完)延到
           ~06:10-06:40 左右完。
         · 06:50 開波,05:00 slot 一定做完晒(50-40 分鐘緩衝),DB 鎖一早放低。
           呢個 job 用 hymnDb.js 嘅 acquireDbLock/releaseDbLock 即攞即放(同
           fetchLyrics.js 一致嘅 pattern),就算偶然重疊都唔會撞崩,但擺定
           緩衝好過夜夜靠鎖 retry 頂。
         · budget=60,每首 bestaudio(冇video,輕)+whisper 實測(golden test
           141/48/1725)~15-25 秒(small model)/~20-25 秒(medium),60 首 x
           ~25 秒 + jitter delay ~5 秒 ≈ 30 分鐘,06:50 到 09:00 窗口尾仲有
           成 2 個鐘,夠鬆有突。59 首存貨一晚應該做晒,之後呢個 job 每晚幾秒
           no-op(候選清空),唔使停用。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/hymn_alignbackfill.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hymn_alignbackfill.log</string>
</dict>
</plist>
