// ================================================================
//  FULL SCREEN PLAYER OVERLAY — TrackPlayer 版（無 YouTube Iframe）
// ================================================================
function FullScreenPlayerOverlay() {
  const insets = typeof useSafeAreaInsets === 'function' ? useSafeAreaInsets() : { top: 0, bottom: 0 };
  const player = usePlayer();

  const [liked, setLiked] = useState(false);
  const queue = player.queue || [];
  const [sheetVisible, setSheetVisible] = useState(false);
  const [lyricsVisible, setLyricsVisible] = useState(false);
  const SHEET_HEIGHT = Math.floor(SCREEN_HEIGHT * 0.45);
  const HANDLE_LIFT = SHEET_HEIGHT;
  const CONTROLS_LIFT = 295;
  const drawerAnim = useRef(new Animated.Value(0)).current;
  const sheetAnim = useRef(new Animated.Value(0)).current;
  const lyricsAnim = useRef(new Animated.Value(0)).current;
  const sheetOpacity = useRef(new Animated.Value(0)).current;

  const sheetVisibleRef = useRef(false);
  sheetVisibleRef.current = sheetVisible;
  const toggleSheetRef = useRef(() => {});
  toggleSheetRef.current = toggleSheet;
  const handlePanRef = useRef(null);
  if (!handlePanRef.current) {
    handlePanRef.current = PanResponder.create({
      onStartShouldSetPanResponder: () => true,
      onMoveShouldSetPanResponder: () => true,
      onPanResponderTerminationRequest: () => false,
      onPanResponderGrant: () => {},
      onPanResponderMove: () => {},
      onPanResponderRelease: (_, gs) => {
        const fn = toggleSheetRef.current;
        if (Math.abs(gs.dy) < 5) fn();
        else if (gs.dy > 15 && sheetVisibleRef.current) fn();
        else if (gs.dy < -15 && !sheetVisibleRef.current) fn();
      },
    });
  }

  function toggleSheet() {
    if (sheetVisible) {
      Animated.timing(sheetAnim, { toValue: 0, duration: 250, useNativeDriver: false }).start(() => setSheetVisible(false));
      Animated.parallel([
        Animated.timing(drawerAnim, { toValue: 0, duration: 250, useNativeDriver: true }),
        Animated.timing(sheetOpacity, { toValue: 0, duration: 200, useNativeDriver: true }),
      ]).start();
    } else {
      setLyricsVisible(false); setSheetVisible(true);
      sheetOpacity.setValue(1);
      requestAnimationFrame(() => {
        Animated.timing(sheetAnim, { toValue: 1, duration: 300, useNativeDriver: false }).start();
        Animated.timing(drawerAnim, { toValue: 1, duration: 300, useNativeDriver: true }).start();
      });
    }
  }

  function toggleLyrics() {
    if (lyricsVisible) {
      Animated.timing(lyricsAnim, { toValue: 0, duration: 250, useNativeDriver: true }).start(() => setLyricsVisible(false));
    } else {
      setSheetVisible(false); setLyricsVisible(true);
      requestAnimationFrame(() => Animated.timing(lyricsAnim, { toValue: 1, duration: 300, useNativeDriver: true }).start());
    }
  }

  const cur = player.currentHymn || { title: '', artist: '', youtube_id: '', id: null, lyrics: '' };
  const progressPercent = player.duration > 0 ? Math.min((player.currentTime / player.duration) * 100, 100) : 0;
  const bottomPad = (insets?.bottom || 20) + 8;

  return (
    <View style={[fsStyles.container, { paddingBottom: bottomPad }]}>
      <StatusBar barStyle="light-content" backgroundColor="transparent" translucent />

      {/* Top Bar */}
      <View style={[fsStyles.topBar, { paddingTop: (insets?.top || StatusBar.currentHeight || 24) + 8 }]}>
        <TouchableOpacity style={fsStyles.dismissBtn} onPress={player.hidePlayer}>
          <Text style={fsStyles.dismissIcon}>{ICONS.dismissDown}</Text>
        </TouchableOpacity>
        <Text style={fsStyles.topBarTitle}>生命樹</Text>
        <View style={fsStyles.dismissBtn} />
      </View>

      {/* Album Art — 取代舊嘅 YouTube Iframe */}
      <View style={fsStyles.videoContainer}>
        <View style={fsStyles.videoCover}>
          {cur.youtube_id ? (
            <Image source={{ uri: getAlbumCoverUrl(cur.youtube_id) }} style={fsStyles.videoCoverImg} />
          ) : null}
          {/* Animated equalizer bars when playing */}
          {player.isPlaying && (
            <View style={fsStyles.equalizerContainer}>
              <View style={[fsStyles.equalizerBar, fsStyles.equalizerBar1]} />
              <View style={[fsStyles.equalizerBar, fsStyles.equalizerBar2]} />
              <View style={[fsStyles.equalizerBar, fsStyles.equalizerBar3]} />
              <View style={[fsStyles.equalizerBar, fsStyles.equalizerBar4]} />
            </View>
          )}
        </View>
      </View>

      {/* 上半彈簧 */}
      <View style={{ flex: 1 }} />

      {/* 電梯 1：控制區 */}
      <Animated.View style={{
        zIndex: 99,
        transform: [{
          translateY: drawerAnim.interpolate({
            inputRange: [0, 1],
            outputRange: [0, -CONTROLS_LIFT],
          }),
        }],
      }}>
        {/* Song info (展開時淡出) */}
        <Animated.View style={{
          opacity: sheetAnim.interpolate({ inputRange: [0, 1], outputRange: [1, 0] }),
          overflow: 'hidden',
        }}>
          <View style={fsStyles.songInfo}>
            <Text style={fsStyles.songTitle} numberOfLines={2}>{cur.title}</Text>
            <Text style={fsStyles.songArtist}>{cur.artist}</Text>
          </View>
        </Animated.View>

        {/* 進度條 + 控制按鈕 */}
        <View>
          <View style={fsStyles.progressSection}>
            <TouchableOpacity style={fsStyles.progressBarTouchArea} onPress={(e) => { player.handleProgressBarPress(e); }}>
              <View style={fsStyles.progressBarBg}>
                <View style={[fsStyles.progressBarFill, { width: `${progressPercent}%` }]}>
                  <View style={fsStyles.progressBarThumb} />
                </View>
              </View>
            </TouchableOpacity>
            <View style={fsStyles.timeRow}>
              <Text style={fsStyles.timeText}>{player.formatTime(player.currentTime)}</Text>
              <Text style={fsStyles.timeText}>{player.formatTime(player.duration)}</Text>
            </View>
          </View>
          <View style={fsStyles.controlsRow}>
            <TouchableOpacity style={fsStyles.controlBtn} onPress={() => player.setIsShuffled?.(s => !s)} activeOpacity={0.6}>
              <View style={{ alignItems: 'center' }}>
                <Text style={[fsStyles.ctrlIconShuffle, player.isShuffled && fsStyles.ctrlIconActive]}>{ICONS.shuffle}</Text>
                {player.isShuffled && <View style={fsStyles.ctrlActiveDot} />}
              </View>
            </TouchableOpacity>
            <TouchableOpacity style={fsStyles.controlBtn} onPress={player.handlePrevTrack} activeOpacity={0.6}>
              <Text style={fsStyles.ctrlIconPrev}>{ICONS.skipBack}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={fsStyles.playBtn} onPress={player.togglePlayPause} activeOpacity={0.8}>
              <Text style={fsStyles.playBtnIcon}>{player.isPlaying ? ICONS.pause : ICONS.play}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={fsStyles.controlBtn} onPress={player.handleNextTrack} activeOpacity={0.6}>
              <Text style={fsStyles.ctrlIconNext}>{ICONS.skipForward}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={fsStyles.controlBtn} onPress={() => player.setRepeatMode?.((player.repeatMode + 1) % 3)} activeOpacity={0.6}>
              <View style={{ alignItems: 'center' }}>
                <MaterialIcons
                  name={player.repeatMode === 2 ? 'repeat-one' : 'repeat'}
                  size={32}
                  style={{ color: player.repeatMode > 0 ? ACCENT_COLOR : 'rgba(255,255,255,0.6)' }}
                />
                {player.repeatMode > 0 && <View style={fsStyles.ctrlActiveDot} />}
              </View>
            </TouchableOpacity>
          </View>
        </View>
      </Animated.View>

      {/* 下半彈簧 */}
      <View style={{ flex: 1 }} />

      {/* 電梯 2：Handle + Sheet */}
      <Animated.View style={{
        transform: [{
          translateY: drawerAnim.interpolate({
            inputRange: [0, 1],
            outputRange: [0, -HANDLE_LIFT],
          }),
        }],
      }}>
        <View style={{
          paddingVertical: 10, paddingHorizontal: 20,
          backgroundColor: CARD_BG_COLOR, borderTopLeftRadius: 20, borderTopRightRadius: 20,
        }}
          {...handlePanRef.current?.panHandlers}
        >
          <View style={{ alignItems: 'center' }}>
            <View style={fsStyles.handleBar} />
            <View style={fsStyles.sheetHandleRow}>
              <Text style={fsStyles.sheetTitle}>📋 播放清單</Text>
              <Text style={fsStyles.sheetCount}>{queue.length} 首</Text>
            </View>
          </View>
        </View>
      </Animated.View>

      {/* 獨立清單 */}
      <Animated.View style={{
        position: 'absolute',
        left: 0, right: 0,
        bottom: -SHEET_HEIGHT + 50,
        height: SHEET_HEIGHT,
        backgroundColor: CARD_BG_COLOR,
        opacity: sheetOpacity,
        transform: [{
          translateY: drawerAnim.interpolate({
            inputRange: [0, 1],
            outputRange: [0, -HANDLE_LIFT],
          }),
        }],
      }}>
        <FlatList
          data={queue}
          keyExtractor={item => String(item.id)}
          renderItem={({ item }) => (
            <TouchableOpacity style={[fsStyles.queueItem, item.id === cur.id && fsStyles.queueItemActive]}
              onPress={() => { player.handlePlayFromQueue(item); }} activeOpacity={0.7}>
              <Image source={{ uri: getAlbumCoverUrl(item.youtube_id) }} style={fsStyles.queueCover} />
              <View style={fsStyles.queueInfo}>
                <Text style={fsStyles.queueTitle} numberOfLines={1}>{item.title}</Text>
                <Text style={fsStyles.queueArtist} numberOfLines={1}>{item.artist}</Text>
              </View>
              {item.id === cur.id ? (
                <Text style={fsStyles.queuePlayingIcon}>▶</Text>
              ) : (
                <Text style={fsStyles.queueDragIcon}>{ICONS.queueBars}</Text>
              )}
            </TouchableOpacity>
          )}
          scrollEnabled={true}
          contentContainerStyle={{ paddingBottom: 12 }}
        />
      </Animated.View>

      {/* Lyrics overlay */}
      {lyricsVisible && (
        <Animated.View style={[fsStyles.lyricsContainer, { transform: [{ translateY: lyricsAnim.interpolate({ inputRange: [0,1], outputRange: [400,0] }) }] }]}>
          <View style={fsStyles.lyricsHeader}>
            <Text style={fsStyles.lyricsTitle}>📄 歌詞</Text>
            <TouchableOpacity onPress={toggleLyrics}><Text style={fsStyles.lyricsClose}>✕</Text></TouchableOpacity>
          </View>
          <ScrollView style={fsStyles.lyricsScroll}>
            <Text style={fsStyles.lyricsBody}>{cur.lyrics || '暫無歌詞'}</Text>
          </ScrollView>
        </Animated.View>
      )}

    </View>
  );
}

