<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- Android 13+(API 33)冇呢個 permission 就post唔到任何notification,包括
       react-native-track-player 個背景播放媒體控制通知——冧咗個離開App後嘅
       mini player(2026-07-30 Eric 實測,STREAM-403-FGS-CRASH-PLAN 已知問題)。 -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- BATCH6 C6:App 冇任何讀寫外部儲存/懸浮窗功能,剷走呢三個權限。
       tools:node="remove" 係叫 manifest merger 連 library manifest 帶入嚟嘅
       同名聲明都一齊剷,齋刪行剷唔乾淨。SYSTEM_ALERT_WINDOW 喺 debug overlay
       (src/debug/AndroidManifest.xml)有自己一份俾 dev 工具用,唔受影響
       (overlay priority 高過 main,remove 只向下游 library 生效)。 -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="true"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATE_URL" android:value="https://u.expo.dev/2fc23a2a-dc9e-4f29-b2f6-a337ee4c692a"/>
    <meta-data android:name="expo.modules.updates.EXPO_RUNTIME_VERSION" android:value="@string/expo_runtime_version"/>
    <meta-data android:name="expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY" android:value="{&quot;expo-channel-name&quot;:&quot;production&quot;}"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- MEMBERSHIP-PHASE3-SHARE-PLAN 分享清單 deep link + ODE-REBRAND-PLAN
           §3.5 domain 遷移。⚠️ 呢個 project 係 bare workflow(android/ 落咗
           git),app.json 嘅 intentFilters 唔會自動同步入呢個檔案——rebrand
           驗收(emulator 實測 adb am start -d "https://...")先發現呢個
           intent-filter 之前根本冇落過 manifest(app.json 寫咗但冇生效,
           分享連結一路淨係靠 SSR 頁嘅 intent:// 掣先開到 app,直接撳
           https 連結會走去瀏覽器)。而家補返:https(雙域)+ godmusic://
           scheme 兩個 intent-filter,同 App.js parseSharedToken() 認嘅
           URL 對齊。 -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="api.god-music.com" android:pathPrefix="/p/"/>
        <data android:scheme="https" android:host="api.odemusics.com" android:pathPrefix="/p/"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="godmusic" android:host="p"/>
      </intent-filter>
    </activity>
  </application>
</manifest>