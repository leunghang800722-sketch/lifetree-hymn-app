// 詩歌App v134 expo-av — 純 expo-av 背景播放
import React, { useState, useEffect, createContext, useContext, useRef, useCallback } from 'react';
import MaterialIcons from '@expo/vector-icons/MaterialIcons';
import { Audio } from 'expo-av';
import * as Notifications from 'expo-notifications';
import {
  View, Text, ScrollView, TouchableOpacity, StyleSheet,
  ActivityIndicator, StatusBar, Image, Platform,
  Animated, Dimensions, PanResponder,
} from 'react-native';

const ICONS = {
  shuffle: '⇆', repeat: '↻', heart: '♥',
  heartOutline: '♡', skipBack: '⏮', skipForward: '⏭',
  play: '▶', pause: '❚❚', dismissDown: '▼', queueBars: '☰',
};

let SafeAreaProvider = null, useSafeAreaInsets = null;
try {
  const sac = require('react-native-safe-area-context');
  SafeAreaProvider = sac.SafeAreaProvider;
  useSafeAreaInsets = sac.useSafeAreaInsets;
} catch (e) {}

const API_BASE = 'http://192.168.30.45:3000';
const { width: SCREEN_WIDTH, height: SCREEN_HEIGHT } = Dimensions.get('window');
const MAIN_BG_COLOR = '#131C16';
const CARD_BG_COLOR = '#1E2B22';
const ACCENT_COLOR = '#A8C765';
const TEXT_PRIMARY = '#F0F4E8';
const TEXT_SECONDARY = '#9AA696';

function getAlbumCoverUrl(youtubeId) {
  return youtubeId ? 'https://img.youtube.com/vi/' + youtubeId + '/hqdefault.jpg' : null;
}

const FALLBACK_HYMNS = [
  { id: 1, title: '恩典太美麗', artist: 'ACM', youtube_id: 'JlTb0Sf7xUg', lang: '粵語' },
  { id: 2, title: '這一生最美的祝福', artist: '讚美之泉', youtube_id: 'tPf7Ig1ebL4', lang: '國語' },
  { id: 3, title: '我要向高山舉目', artist: '玻璃海', youtube_id: 'HfE3WNcdDTk', lang: '粵語' },
];
const STATIC_PLAYLIST = FALLBACK_HYMNS.concat(
  FALLBACK_HYMNS.map(function(h) { return {...h, id: h.id + 1000}; }),
  FALLBACK_HYMNS.map(function(h) { return {...h, id: h.id + 2000}; }),
  FALLBACK_HYMNS.map(function(h) { return {...h, id: h.id + 3000, title: h.title + ' (copy)'}; })
);

const DAILY_VERSE = { text: '應當一無掛慮，只要凡事藉著禱告、祈求和感謝，將你們所要的告訴神。', ref: '腓立比書 4:6' };
const CATEGORIES = ['全部', '平安', '讚美', '靈修', '醫治', '信心', '恩典', '復興'];

async function safeFetchAllHymns() {
  try {
    var r = await fetch(API_BASE + '/api/hymns');
    if (!r.ok) return [];
    var d = await r.json();
    var arr = d.data || d;
    return Array.isArray(arr) ? arr : [];
  } catch (e) { return []; }
}

async function fetchAudioUrl(youtubeId) {
  if (!youtubeId) return null;
  try {
    var res = await fetch(API_BASE + '/api/audio/' + youtubeId);
    if (!res.ok) return null;
    var data = await res.json();
    if (data.success && data.url) return data.url;
  } catch (e) { console.warn('fetchAudioUrl error:', e); }
  return null;
}

const PlayerCtx = createContext();

function getQueue(hymns) {
  return Array.isArray(hymns) && hymns.length > 0 ? hymns : STATIC_PLAYLIST;
}

function PlayerProvider({ children }) {
  const [currentHymn, setCurrentHymn] = useState(null);
  var [hymn, setHymn] = useState(null);
  var [hymns, setHymns] = useState(null);
  var [currentTime, setCurrentTime] = useState(0);
  var [duration, setDuration] = useState(0);
  var [isPlaying, setIsPlaying] = useState(false);
  var [repeatMode, setRepeatMode] = useState(0);
  var [isShuffled, setIsShuffled] = useState(false);
  var [currentQueueIndex, setCurrentQueueIndex] = useState(0);

  var soundRef = useRef(null);
  var currentQueueIndexRef = useRef(0);
  var repeatModeRef = useRef(0);
  var isShuffledRef = useRef(false);
  var mountedRef = useRef(true);
  var advanceFnRef = useRef(null);

  repeatModeRef.current = repeatMode;
  isShuffledRef.current = isShuffled;

  var overlayY = useRef(new Animated.Value(SCREEN_HEIGHT)).current;
  var [overlayExpanded, setOverlayExpanded] = useState(false);

  var showPlayer = useCallback(function() {
    if (!overlayExpanded) {
      setOverlayExpanded(true);
      Animated.spring(overlayY, {
        toValue: 0, useNativeDriver: true,
        damping: 20, stiffness: 120, mass: 0.8,
      }).start();
    }
  }, [overlayExpanded, overlayY]);

  var hidePlayer = useCallback(function() {
    if (overlayExpanded) {
      setOverlayExpanded(false);
      Animated.timing(overlayY, {
        toValue: SCREEN_HEIGHT, duration: 250, useNativeDriver: true,
      }).start();
    }
  }, [overlayExpanded, overlayY]);

  function formatTime(seconds) {
    if (!seconds || isNaN(seconds)) return '0:00';
    var m = Math.floor(seconds / 60);
    var s = Math.floor(seconds % 60);
    return m + ':' + (s < 10 ? '0' : '') + s;
  }

  async function advanceTrack(direction) {
    var q = getQueue(hymns);
    if (!q.length) return;
    var nextIdx;
    if (direction > 0) {
      nextIdx = isShuffledRef.current
        ? Math.floor(Math.random() * q.length)
        : (currentQueueIndexRef.current + 1) % q.length;
    } else {
      nextIdx = currentQueueIndexRef.current > 0 ? currentQueueIndexRef.current - 1 : q.length - 1;
    }
    await changeToSong(q[nextIdx], nextIdx);
  }

  advanceFnRef.current = function() { advanceTrack(1); };

  async function changeToSong(song, queueIndex) {
    if (!song) return;
    var q = getQueue(hymns);
    var idx = typeof queueIndex === 'number' ? queueIndex : q.findIndex(function(h) { return h.id === song.id; });
    if (idx < 0) idx = 0;
    currentQueueIndexRef.current = idx;
    setCurrentQueueIndex(idx);
    setCurrentTime(0);
    setDuration(0);
    setHymn(song);
    setCurrentHymn(song);
    if (soundRef.current) {
      try { await soundRef.current.stopAsync(); await soundRef.current.unloadAsync(); } catch (e) {}
      soundRef.current = null;
    }
    try {
      var audioUrl = await fetchAudioUrl(song.youtube_id);
      if (!audioUrl) return;
      var result = await Audio.Sound.createAsync(
        { uri: audioUrl },
        { shouldPlay: true, progressUpdateIntervalMillis: 500 },
        function(status) {
          if (!status || !mountedRef.current) return;
          if (status.isLoaded) {
            setCurrentTime(status.positionMillis / 1000);
            setDuration(status.durationMillis / 1000);
            setIsPlaying(status.isPlaying);
            if (status.didJustFinish) {
              if (repeatModeRef.current === 2) {
                soundRef.current && soundRef.current.setPositionAsync(0).then(function() {
                  soundRef.current && soundRef.current.playAsync();
                }).catch(function(){});
              } else if (advanceFnRef.current) {
                advanceFnRef.current();
              }
            }
          }
          setIsPlaying(status.isPlaying);
        }
      );
      soundRef.current = result.sound;
    } catch (e) { console.warn('changeToSong error:', e); }
  }

  async function togglePlayPause() {
    if (!soundRef.current) return;
    try {
      if (isPlaying) { await soundRef.current.pauseAsync(); }
      else { await soundRef.current.playAsync(); }
    } catch (e) {}
  }

  async function requestNotificationPermission() {
  if (Platform.OS === 'android') {
    try {
      const { status } = await Notifications.requestPermissionsAsync();
      if (status !== 'granted') {
        console.log('Notification permission not granted');
      }
    } catch (e) {
      console.warn('Notif permission error:', e);
    }
  }
}

function handleProgressBarPress(evt) {
    if (!duration || !soundRef.current) return;
    var x = evt.nativeEvent.locationX;
    if (typeof x !== 'number') return;
    var targetSec = (x / (SCREEN_WIDTH - 40)) * duration;
    setCurrentTime(targetSec);
    soundRef.current.setPositionAsync(targetSec * 1000).catch(function(){});
  }

  useEffect(function() {
    var mounted = true;
    async function init() {
      // Android 16+ requires runtime POST_NOTIFICATIONS permission
      await requestNotificationPermission();
      try {
        await Audio.setAudioModeAsync({
          allowsRecordingIOS: false,
          staysActiveInBackground: true,
          playsInSilentModeIOS: true,
          shouldDuckAndroid: true,
          playThroughEarpieceAndroid: false,
        });
      } catch (e) { console.warn('Audio init:', e); }
      if (mounted) setHymns([]);
    }
    init();
    return function() {
      mounted = false;
      mountedRef.current = false;
      if (soundRef.current) { soundRef.current.stopAsync().catch(function(){}); soundRef.current.unloadAsync().catch(function(){}); }
    };
  }, []);

  var activeHymn = hymn || currentHymn || { title: '', artist: '', youtube_id: '', id: null };

  return (
    <PlayerCtx.Provider value={{
      currentHymn: activeHymn, hymn: hymn, hymns: hymns, setHymns: setHymns,
      isPlaying: isPlaying, currentTime: currentTime, duration: duration,
      repeatMode: repeatMode, isShuffled: isShuffled, setIsShuffled: setIsShuffled,
      currentQueueIndex: currentQueueIndex, queue: getQueue(hymns),
      overlayExpanded: overlayExpanded,
      changeToSong: changeToSong, togglePlayPause: togglePlayPause,
      handlePlayFromQueue: function(item) {
        if (!item) return;
        var q = getQueue(hymns);
        var idx = q.findIndex(function(h) { return h.id === item.id; });
        if (idx >= 0) changeToSong(item, idx);
      },
      handleNextTrack: function() { advanceTrack(1); },
      handlePrevTrack: function() { advanceTrack(-1); },
      setRepeatMode: setRepeatMode,
      handleProgressBarPress: handleProgressBarPress,
      formatTime: formatTime,
      showPlayer: showPlayer, hidePlayer: hidePlayer,
    }}>
      {children}
      <Animated.View style={[olStyles.overlay, { transform: [{ translateY: overlayY }] }]}>
        <FullScreenPlayerOverlay />
      </Animated.View>
    </PlayerCtx.Provider>
  );
}
function usePlayer() {
  return useContext(PlayerCtx) || {};
}
const olStyles = StyleSheet.create({
  overlay: { position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, backgroundColor: MAIN_BG_COLOR, zIndex: 999 },
});
// ================================================================
// MINI PLAYER
// ================================================================
function MiniPlayer({ onPress }) {
  var p = usePlayer();
  if (!p.currentHymn || !p.currentHymn.id) return null;
  var progressPct = p.duration > 0 ? Math.min((p.currentTime/p.duration)*100, 100) : 0;
  var img = getAlbumCoverUrl(p.currentHymn.youtube_id);
  var dot = { width: 4, height: 4, borderRadius: 2, backgroundColor: ACCENT_COLOR, marginTop: 2 };
  return (
    <View style={miWrap}>
      <TouchableOpacity style={miCont} onPress={onPress} activeOpacity={0.9}>
        <View style={miRow}>
          {img ? <Image source={{ uri: img }} style={miCover} /> : <View style={miCover} />}
          <View style={miInfo}>
            <Text style={miTitle} numberOfLines={1}>{p.currentHymn.title}</Text>
            <Text style={miArtist} numberOfLines={1}>{p.currentHymn.artist}</Text>
          </View>
        </View>
        <View style={{ marginBottom: 6 }}>
          <View style={{ height: 24, justifyContent: 'center' }}>
            <View style={{ height: 4, backgroundColor: 'rgba(255,255,255,0.15)', borderRadius: 2 }}>
              <View style={{ height: 4, backgroundColor: ACCENT_COLOR, borderRadius: 2, width: progressPct + '%' }} />
            </View>
          </View>
          <View style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={miTime}>{p.formatTime(p.currentTime)}</Text>
            <Text style={miTime}>{p.formatTime(p.duration)}</Text>
          </View>
        </View>
        <View style={{ flexDirection: 'row', justifyContent: 'space-evenly', alignItems: 'center' }}>
          <TouchableOpacity style={miBtn} onPress={function(e){ e.stopPropagation(); p.setIsShuffled(function(s){ return !s; }); }} activeOpacity={0.6}>
            <View>
              <Text style={[miIcon, p.isShuffled && {color: ACCENT_COLOR}]}>{ICONS.shuffle}</Text>
              {p.isShuffled ? <View style={dot} /> : null}
            </View>
          </TouchableOpacity>
          <TouchableOpacity style={miBtn} onPress={function(e){ e.stopPropagation(); p.handlePrevTrack(); }} activeOpacity={0.6}>
            <Text style={[miIcon, {fontSize:24,color:'#FFF'}]}>{ICONS.skipBack}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={miPlayBtn} onPress={function(e){ e.stopPropagation(); p.togglePlayPause(); }} activeOpacity={0.8}>
            <Text style={{fontSize:20,color:'#000',marginLeft:2}}>{p.isPlaying ? ICONS.pause : ICONS.play}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={miBtn} onPress={function(e){ e.stopPropagation(); p.handleNextTrack(); }} activeOpacity={0.6}>
            <Text style={[miIcon, {fontSize:24,color:'#FFF'}]}>{ICONS.skipForward}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={miBtn} onPress={function(e){ e.stopPropagation(); p.setRepeatMode((p.repeatMode + 1) % 3); }} activeOpacity={0.6}>
            <View>
              <MaterialIcons name={p.repeatMode === 2 ? 'repeat-one' : 'repeat'} size={28}
                style={{color: p.repeatMode > 0 ? ACCENT_COLOR : 'rgba(255,255,255,0.6)'}} />
              {p.repeatMode > 0 ? <View style={dot} /> : null}
            </View>
          </TouchableOpacity>
        </View>
      </TouchableOpacity>
    </View>
  );
}
var miWrap = { marginHorizontal: 10, marginBottom: 0 };
var miCont = { backgroundColor: CARD_BG_COLOR, borderRadius: 16, paddingHorizontal: 14, paddingTop: 12, paddingBottom: 10 };
var miRow = { flexDirection: 'row', alignItems: 'center', marginBottom: 8 };
var miCover = { width: 50, height: 50, borderRadius: 10, backgroundColor: '#161F19' };
var miInfo = { flex: 1, marginLeft: 12 };
var miTitle = { fontSize: 15, fontWeight: '700', color: TEXT_PRIMARY };
var miArtist = { fontSize: 12, color: TEXT_SECONDARY, marginTop: 2 };
var miTime = { fontSize: 10, color: TEXT_SECONDARY };
var miBtn = { width: 44, height: 44, justifyContent: 'center', alignItems: 'center' };
var miIcon = { fontSize: 28, color: TEXT_SECONDARY };
var miPlayBtn = { width: 56, height: 56, borderRadius: 28, backgroundColor: '#FFF', justifyContent: 'center', alignItems: 'center' };

// ================================================================
// TAB BAR
// ================================================================
var TABS = [
  { key: 'Home', label: '首頁', emoji: '🏠' },
  { key: 'Categories', label: '詩歌', emoji: '🎵' },
  { key: 'Playlist', label: '清單', emoji: '📋' },
  { key: 'Favorites', label: '最愛', emoji: '❤️' },
];
function TabBar({ bottomInset, onMiniPlayerPress }) {
  var [activeTab, setActiveTab] = useState('Home');
  var safePad = Math.max(bottomInset || 0, 4);
  return (
    <View style={{ backgroundColor: MAIN_BG_COLOR, paddingBottom: safePad }}>
      <View style={{ marginBottom: 6 }}>
        <MiniPlayer onPress={onMiniPlayerPress} />
      </View>
      <View style={{ flexDirection: 'row', backgroundColor: MAIN_BG_COLOR, paddingTop: 4 }}>
        {TABS.map(function(tab) { return (
          <TouchableOpacity key={tab.key} style={tbItem} onPress={function(){ setActiveTab(tab.key); }}>
            <Text style={{fontSize:18}}>{tab.emoji}</Text>
            <Text style={[tbLabel, activeTab === tab.key && tbLabelActive]}>{tab.label}</Text>
          </TouchableOpacity>
        ); })}
        <TouchableOpacity style={tbItem} onPress={function(){
          setActiveTab('Player');
          if (onMiniPlayerPress) onMiniPlayerPress();
        }}>
          <Text style={{fontSize:18}}>▶️</Text>
          <Text style={[tbLabel, activeTab === 'Player' && tbLabelActive]}>播放</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
}
var tbItem = { flex: 1, alignItems: 'center', paddingVertical: 6 };
var tbLabel = { fontSize: 10, color: TEXT_SECONDARY, marginTop: 2, fontWeight: '500' };
var tbLabelActive = { color: TEXT_PRIMARY, fontWeight: '700' };

// ================================================================
// HOME
// ================================================================
function HomeScreen({ hymns, onPlayHymn }) {
  var safe = hymns || [];
  return (
    <ScrollView style={{flex:1,backgroundColor:MAIN_BG_COLOR}} contentContainerStyle={{paddingBottom:20}}>
      <View style={{paddingHorizontal:20, paddingVertical:12, paddingTop: (StatusBar.currentHeight || 24) + 12}}>
        <Text style={{fontSize:28,fontWeight:'800',color:TEXT_PRIMARY}}>生命樹</Text>
        <Text style={{fontSize:14,color:TEXT_SECONDARY,fontWeight:'500',marginTop:2}}>Etz Chayim</Text>
      </View>
      <TouchableOpacity style={{marginHorizontal:16, padding:16, backgroundColor:CARD_BG_COLOR, borderRadius:16, marginBottom:20}} activeOpacity={0.9}>
        <Text style={{fontSize:11,color:ACCENT_COLOR,fontWeight:'600',marginBottom:10,letterSpacing:1}}>✝️ DAILY VERSE 每日金句</Text>
        <Text style={{fontSize:17,color:TEXT_PRIMARY,lineHeight:26,fontWeight:'500'}}>{DAILY_VERSE.text}</Text>
        <Text style={{fontSize:13,color:TEXT_SECONDARY,marginTop:10,fontStyle:'italic'}}>— {DAILY_VERSE.ref}</Text>
      </TouchableOpacity>
      <View style={{flexDirection:'row',justifyContent:'space-between',alignItems:'center',paddingHorizontal:20,marginBottom:12}}>
        <Text style={{fontSize:18,fontWeight:'700',color:TEXT_PRIMARY}}>全部詩歌</Text>
        <Text style={{fontSize:12,color:TEXT_SECONDARY}}>{safe.length} 首</Text>
      </View>
      {safe.length === 0 ? (
        <View style={{padding:40,alignItems:'center'}}>
          <Text style={{fontSize:14,color:TEXT_SECONDARY}}>正在連線伺服器...</Text>
          <ActivityIndicator color={ACCENT_COLOR} style={{marginTop:12}} />
        </View>
      ) : null}
      {safe.map(function(h) { return (
        <TouchableOpacity key={h.id} style={{flexDirection:'row',alignItems:'center',paddingHorizontal:20,paddingVertical:10}}
          onPress={function(){ if (onPlayHymn) onPlayHymn(h); }}>
          {h.youtube_id ? (
            <Image source={{ uri: getAlbumCoverUrl(h.youtube_id) }} style={{width:44,height:44,borderRadius:8,backgroundColor:'#161F19'}} />
          ) : (
            <View style={{width:44,height:44,borderRadius:8,backgroundColor:'#161F19',justifyContent:'center',alignItems:'center'}}>
              <Text style={{fontSize:18}}>🎵</Text>
            </View>
          )}
          <View style={{flex:1,marginLeft:12}}>
            <Text style={{fontSize:14,fontWeight:'600',color:TEXT_PRIMARY}} numberOfLines={1}>{h.title}</Text>
            <Text style={{fontSize:12,color:TEXT_SECONDARY,marginTop:2}} numberOfLines={1}>{h.artist || ''}</Text>
          </View>
          <Text style={{fontSize:16,color:ACCENT_COLOR,paddingLeft:8}}>{ICONS.play}</Text>
        </TouchableOpacity>
      ); })}
      <View style={{height:40}} />
    </ScrollView>
  );
}
// ================================================================
// FULL SCREEN PLAYER
// ================================================================
var SHEET_HEIGHT = Math.floor(SCREEN_HEIGHT * 0.45);
var HANDLE_LIFT = SHEET_HEIGHT;
var CONTROLS_LIFT = 295;

function FullScreenPlayerOverlay() {
  var insets = typeof useSafeAreaInsets === 'function' ? useSafeAreaInsets() : { top: 0, bottom: 0 };
  var p = usePlayer();
  var cur = p.currentHymn || { title: '', artist: '', youtube_id: '', id: null };
  var progressPct = p.duration > 0 ? Math.min((p.currentTime/p.duration)*100, 100) : 0;
  var bottomPad = (insets.bottom || 20) + 8;

  var [sheetVisible, setSheetVisible] = useState(false);
  var drawerAnim = useRef(new Animated.Value(0)).current;
  var sheetAnim = useRef(new Animated.Value(0)).current;
  var sheetOpacity = useRef(new Animated.Value(0)).current;
  var sheetVisRef = useRef(false);
  sheetVisRef.current = sheetVisible;

  function toggleSheet() {
    if (sheetVisible) {
      Animated.timing(sheetAnim, { toValue: 0, duration: 250, useNativeDriver: false }).start(function(){ setSheetVisible(false); });
      Animated.parallel([
        Animated.timing(drawerAnim, { toValue: 0, duration: 250, useNativeDriver: true }),
        Animated.timing(sheetOpacity, { toValue: 0, duration: 200, useNativeDriver: true }),
      ]).start();
    } else {
      setSheetVisible(true);
      sheetOpacity.setValue(1);
      requestAnimationFrame(function() {
        Animated.timing(sheetAnim, { toValue: 1, duration: 300, useNativeDriver: false }).start();
        Animated.timing(drawerAnim, { toValue: 1, duration: 300, useNativeDriver: true }).start();
      });
    }
  }

  var handlePan = useRef(PanResponder.create({
    onStartShouldSetPanResponder: function(){ return true; },
    onMoveShouldSetPanResponder: function(){ return true; },
    onPanResponderTerminationRequest: function(){ return false; },
    onPanResponderRelease: function(_, gs) {
      if (Math.abs(gs.dy) < 5) toggleSheet();
      else if (gs.dy > 15 && sheetVisRef.current) toggleSheet();
      else if (gs.dy < -15 && !sheetVisRef.current) toggleSheet();
    },
  })).current;

  var img = getAlbumCoverUrl(cur.youtube_id);

  return (
    <View style={{flex:1,backgroundColor:MAIN_BG_COLOR, paddingBottom: bottomPad}}>
      <StatusBar barStyle="light-content" backgroundColor="transparent" translucent />
      <View style={{flexDirection:'row',alignItems:'center',justifyContent:'space-between',
        paddingTop: (insets.top || StatusBar.currentHeight || 24) + 8, paddingHorizontal: 16, paddingBottom: 8}}>
        <TouchableOpacity style={{width:44,height:44,justifyContent:'center',alignItems:'center'}} onPress={p.hidePlayer}>
          <Text style={{fontSize:20,color:TEXT_SECONDARY}}>{ICONS.dismissDown}</Text>
        </TouchableOpacity>
        <Text style={{fontSize:16,fontWeight:'600',color:TEXT_PRIMARY}}>生命樹</Text>
        <View style={{width:44}} />
      </View>

      <View style={{alignItems:'center',marginTop:20}}>
        {img ? (
          <Image source={{ uri: img }} style={{width:SCREEN_WIDTH*0.7,height:SCREEN_WIDTH*0.7*9/16,borderRadius:16,backgroundColor:'#161F19'}} />
        ) : (
          <View style={{width:SCREEN_WIDTH*0.7,height:SCREEN_WIDTH*0.7*9/16,borderRadius:16,backgroundColor:'#161F19',justifyContent:'center',alignItems:'center'}}>
            <Text style={{fontSize:40}}>🎵</Text>
          </View>
        )}
      </View>

      <View style={{flex:1}} />

      <Animated.View style={{
        zIndex: 99,
        transform: [{ translateY: drawerAnim.interpolate({ inputRange: [0,1], outputRange: [0, -CONTROLS_LIFT] }) }],
      }}>
        <Animated.View style={{
          opacity: sheetAnim.interpolate({ inputRange: [0,1], outputRange: [1,0] }),
          overflow: 'hidden',
        }}>
          <View style={{paddingHorizontal:24,marginBottom:8}}>
            <Text style={{fontSize:20,fontWeight:'700',color:TEXT_PRIMARY,textAlign:'center'}} numberOfLines={2}>{cur.title}</Text>
            <Text style={{fontSize:14,color:TEXT_SECONDARY,textAlign:'center',marginTop:4}}>{cur.artist}</Text>
          </View>
        </Animated.View>

        <View style={{paddingHorizontal:20}}>
          <TouchableOpacity style={{height:24,justifyContent:'center'}} onPress={p.handleProgressBarPress}>
            <View style={{height:6,backgroundColor:'rgba(255,255,255,0.15)',borderRadius:3}}>
              <View style={{height:6,backgroundColor:ACCENT_COLOR,borderRadius:3, width: progressPct + '%'}} />
            </View>
          </TouchableOpacity>
          <View style={{flexDirection:'row',justifyContent:'space-between',marginTop:4,marginBottom:12}}>
            <Text style={{fontSize:11,color:TEXT_SECONDARY}}>{p.formatTime(p.currentTime)}</Text>
            <Text style={{fontSize:11,color:TEXT_SECONDARY}}>{p.formatTime(p.duration)}</Text>
          </View>
        </View>

        <View style={{flexDirection:'row',justifyContent:'space-evenly',alignItems:'center',paddingHorizontal:20}}>
          <TouchableOpacity style={{width:48,alignItems:'center'}} onPress={function(){ p.setIsShuffled(function(s){ return !s; }); }} activeOpacity={0.6}>
            <Text style={{fontSize:24,color:p.isShuffled?ACCENT_COLOR:TEXT_SECONDARY}}>{ICONS.shuffle}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={{width:48,height:48,justifyContent:'center',alignItems:'center'}} onPress={p.handlePrevTrack} activeOpacity={0.6}>
            <Text style={{fontSize:28,color:'#FFF'}}>{ICONS.skipBack}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={{width:72,height:72,borderRadius:36,backgroundColor:'#FFF',justifyContent:'center',alignItems:'center'}}
            onPress={p.togglePlayPause} activeOpacity={0.8}>
            <Text style={{fontSize:28,color:'#000',marginLeft:3}}>{p.isPlaying ? ICONS.pause : ICONS.play}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={{width:48,height:48,justifyContent:'center',alignItems:'center'}} onPress={p.handleNextTrack} activeOpacity={0.6}>
            <Text style={{fontSize:28,color:'#FFF'}}>{ICONS.skipForward}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={{width:48,alignItems:'center'}} onPress={function(){ p.setRepeatMode((p.repeatMode+1)%3); }} activeOpacity={0.6}>
            <MaterialIcons name={p.repeatMode===2?'repeat-one':'repeat'} size={28}
              style={{color:p.repeatMode>0?ACCENT_COLOR:TEXT_SECONDARY}} />
          </TouchableOpacity>
        </View>
      </Animated.View>

      <View style={{flex:1}} />

      <Animated.View style={{
        height: SHEET_HEIGHT,
        opacity: sheetAnim.interpolate({ inputRange: [0,0.01,1], outputRange: [0,1,1] }),
        transform: [{ translateY: sheetAnim.interpolate({ inputRange: [0,1], outputRange: [SHEET_HEIGHT,0] }) }],
        overflow: 'hidden', backgroundColor: CARD_BG_COLOR, borderTopLeftRadius: 20, borderTopRightRadius: 20,
      }}>
        <Animated.View style={{
          position: 'absolute', top: 0, left: 0, right: 0, height: HANDLE_LIFT,
          opacity: sheetAnim.interpolate({ inputRange: [0,1], outputRange: [0,1] }),
        }}>
          <TouchableOpacity onPress={toggleSheet} {...handlePan.panHandlers} activeOpacity={0.7}>
            <View style={{alignItems:'center',paddingVertical:10}}>
              <View style={{width:40,height:4,borderRadius:2,backgroundColor:'rgba(255,255,255,0.3)'}} />
            </View>
            <Text style={{fontSize:13,color:TEXT_SECONDARY,textAlign:'center',fontWeight:'500'}}>
              {ICONS.queueBars} 播放清單
            </Text>
          </TouchableOpacity>
          <View style={{paddingVertical:16,alignItems:'center'}}>
            <Text style={{fontSize:12,color:TEXT_SECONDARY}}>播放佇列</Text>
            <Text style={{fontSize:12,color:TEXT_SECONDARY,marginTop:4}}>下拉關閉</Text>
          </View>
        </Animated.View>
      </Animated.View>

      <View style={{flex:0, height: Math.max(insets.bottom || 0, 8)}} />
    </View>
  );
}

// ================================================================
// APP ENTRY
// ================================================================
function AppContent() {
  var p = usePlayer();
  var insets = typeof useSafeAreaInsets === 'function' ? useSafeAreaInsets() : { bottom: 0 };
  var bottomInset = useBottomInset();

  useEffect(function() {
    safeFetchAllHymns().then(function(data) {
      if (data && data.length > 0 && p.setHymns) {
        p.setHymns(data);
      }
    }).catch(function(e) {
      console.warn('fetch hymns error:', e);
    });
  }, []);

  return (
    <View style={{flex:1,backgroundColor:MAIN_BG_COLOR}}>
      <HomeScreen hymns={p.hymns} onPlayHymn={function(h) {
        p.changeToSong(h);
        p.showPlayer();
      }} />
      <TabBar bottomInset={bottomInset} onMiniPlayerPress={function(){
        if (p.currentHymn && p.currentHymn.id) p.showPlayer();
      }} />
    </View>
  );
}

export default function App() {
  var SafeProvider = SafeAreaProvider || function({ children }) { return <View style={{flex:1}}>{children}</View>; };
  return (
    <>
      <StatusBar barStyle="light-content" backgroundColor={MAIN_BG_COLOR} />
      <SafeProvider>
        <PlayerProvider>
          <AppContent />
        </PlayerProvider>
      </SafeProvider>
    </>
  );
}

function useBottomInset() {
  var safe = typeof useSafeAreaInsets === 'function' ? useSafeAreaInsets() : null;
  if (safe && safe.bottom) return safe.bottom;
  if (Platform.OS === 'android') return 20;
  return Platform.OS === 'ios' ? 34 : 0;
}
