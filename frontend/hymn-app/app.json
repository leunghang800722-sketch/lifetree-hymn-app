{
  "expo": {
    "name": "詩歌App",
    "slug": "hymn-app",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hymnapp.praise"
    },
    "android": {
      "package": "com.hymnapp.praise",
      "adaptiveIcon": {
        "backgroundColor": "#1E1B4B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
